# ─────────────────────────────────────────────────────────────────────────────
# Fichier .env.example — LIMTIC Backend
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS COMMITTER LE FICHIER .env (il doit être dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Configuration Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/limtic_db
DB_USERNAME=postgres
DB_PASSWORD=VotreMotDePassePostgres

# Configuration SMTP Gmail (App Password Google — 16 caractères sans espaces)
SMTP_USERNAME=votre.email@etudiant-isi.utm.tn
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Mot de passe du keystore SSL (keystore.p12)
SSL_KEYSTORE_PASSWORD=votre_mot_de_passe_keystore

# Secret hCaptcha (utilisé pour la validation des formulaires)
HCAPTCHA_SECRET=votre_secret_hcaptcha_ici
